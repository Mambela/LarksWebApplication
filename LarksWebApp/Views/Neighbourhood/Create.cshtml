@using LarksWebApp.DTOs.DTO_Neighbourhoods
@using LarksWebApp.DTOs.DTO_Provinces



@model Create_neighbourhood_DTO
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Create a Neighbourhood";
}
<div class="row">
    <div class="col-md-4">
        <div class="col-md-10">  
                    @*ViewBag.CityList is holding all the cities values*@  
                     @Html.LabelFor(model => model.Designation,"Select City ", new { htmlAttributes = new { @class = "form-control" } })
                    @Html.DropDownListFor(m => m.CityId,new SelectList(Model.provinceDTO.Cities,"Id","Designation"),"Select City",new { @class = "form-control" })

            </div>
    </div>
     
    <div class="col-md-4">
         <div class="col-md-10">  
                    @*ViewBag.CityList is holding all the cities values*@
                   @*@Html.DropDownList("Cities",(IEnumerable<SelectListItem>)ViewData["Cities"],  new { @class = "form-control" } )*@
                    @Html.LabelFor(model => model.Designation,"Select Districts ", new { htmlAttributes = new { @class = "form-control" } })
                    @Html.DropDownListFor(m => m.DistrictId,new SelectList(Model.provinceDTO.Districts,"Id","Designation"),"Select District",new { @class = "form-control" })

            </div>
    </div>
    <div class="col-md-4">
         <div class="col-md-10">  
                    @*ViewBag.CityList is holding all the cities values*@
                   @*@Html.DropDownList("Cities",(IEnumerable<SelectListItem>)ViewData["Cities"],  new { @class = "form-control" } *@
                    @Html.LabelFor(model => model.Designation,"Select Municipality ", new { htmlAttributes = new { @class = "form-control" } })
                    @Html.DropDownListFor(m => m.MunicipalityId,new SelectList(Model.provinceDTO.Municipalities,"Id","Designation"),"Select Municipality",new { @class = "form-control"})

            </div>
    </div>
</div>

<div class="col-md-8">
@using(Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-group">
       @Html.LabelFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
       <div class="col-md-10 my-3">
            @Html.EditorFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
       </div>
         <div class="col-md-10">
            @Html.Hidden("newDistrictId")
       </div>
         <div class="col-md-10">
            @Html.Hidden("newMunicipalityId")
       </div>
         <div class="col-md-10">
            @Html.Hidden("newCityId")
       </div>
    </div>

    <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
    </div>
        
}


</div>
