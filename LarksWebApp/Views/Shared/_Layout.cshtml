@using Microsoft.AspNetCore.Identity
@using LarksWebApp.Models.Users
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment HostEnvironment
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool InArea(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));

    var userName = SignInManager.IsSignedIn(User) ? UserManager.GetUserName(User) : null;
    var userInitial = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Larks </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LarksWebApp.styles.css" asp-append-version="true" />
    <link href="~/lib/datatables/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-sidebar__brand">
                <div class="app-sidebar__logo">L</div>
                <div>
                    <div class="app-sidebar__brand-name">LARKS</div>
                    <div class="app-sidebar__brand-sub">Location Directory</div>
                </div>
            </div>

            <nav class="app-sidebar__nav">
                <a class="app-nav-link @(InArea("Home") ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    <span>Dashboard</span>
                </a>
                <a class="app-nav-link @(InArea("Country","Province","Districts") ? "active" : "")" asp-area="" asp-controller="Country" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"/></svg>
                    <span>Country</span>
                </a>
                <a class="app-nav-link @(InArea("Municipalities") ? "active" : "")" asp-area="" asp-controller="Municipalities" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="12"/><path d="M9 21v-6h6v6"/><path d="M12 3 3 9h18L12 3Z"/></svg>
                    <span>Municipalities</span>
                </a>
                <a class="app-nav-link @(InArea("Cities") ? "active" : "")" asp-area="" asp-controller="Cities" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l4-3 4 3v13"/><path d="M13 21V4l4 3v14"/></svg>
                    <span>Cities</span>
                </a>
                <a class="app-nav-link @(InArea("Suburb") ? "active" : "")" asp-area="" asp-controller="Suburb" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>
                    <span>Suburbs</span>
                </a>
                <a class="app-nav-link @(InArea("Street") ? "active" : "")" asp-area="" asp-controller="Street" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3 4 21"/><path d="M15 3l5 18"/><path d="M11 10h2M10 15h4"/></svg>
                    <span>Streets</span>
                </a>
                <a class="app-nav-link @(InArea("Addresses") ? "active" : "")" asp-area="" asp-controller="Addresses" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    <span>Addresses</span>
                </a>
                <a class="app-nav-link @(InArea("Location") ? "active" : "")" asp-area="" asp-controller="Location" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
                    <span>Location</span>
                </a>
                <a class="app-nav-link @(InArea("ManageWebHooks") ? "active" : "")" asp-area="" asp-controller="ManageWebHooks" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15 15 9"/><path d="M10 6.5 12 4.4a3.6 3.6 0 0 1 5.1 5.1L15 11.6"/><path d="M14 17.5 12 19.6a3.6 3.6 0 0 1-5.1-5.1L9 12.4"/></svg>
                    <span>Webhooks</span>
                </a>
                <a class="app-nav-link @(InArea("TokenManager") ? "active" : "")" asp-area="" asp-controller="TokenManager" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M11 12 20 3M16.5 7.5 19 5M20 9l2-2"/></svg>
                    <span>Tokens</span>
                </a>
                <a class="app-nav-link @(InArea("Apispecification") ? "active" : "")" asp-area="" asp-controller="Apispecification" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m9 8-4 4 4 4M15 8l4 4-4 4"/></svg>
                    <span>API Specification</span>
                </a>
            </nav>

            <div class="app-sidebar__user">
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="app-sidebar__user-avatar">@userInitial</div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="app-sidebar__user-name text-truncate">@userName</div>
                        <a id="manage" class="app-sidebar__user-email text-truncate d-block" asp-area="Identity" asp-page="/Account/Manage/Index">Manage account</a>
                    </div>
                    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button id="logout" type="submit" class="app-icon-btn" title="Logout">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                        </button>
                    </form>
                }
                else
                {
                    <div class="app-sidebar__user-avatar">?</div>
                    <div class="flex-grow-1">
                        <a id="login" class="app-sidebar__user-name" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        <div><a id="register" class="app-sidebar__user-email" asp-area="Identity" asp-page="/Account/Register">Register</a></div>
                    </div>
                }
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="app-icon-btn" type="button" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="app-icon-btn" type="button" aria-label="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                </button>
                <span class="app-env-pill">@HostEnvironment.EnvironmentName</span>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 - Larks - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script type="text/javascript">
        $.validator.setDefaults({
            ignore: ""
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @*@await RenderSectionAsync("Resources", required: false)*@
    <script src="~/js/Multi-Functions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
</body>
</html>
