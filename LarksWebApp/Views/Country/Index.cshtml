@model IList<LarksWebApp.DTOs.CountryDTO>
@{
        ViewData["Title"] = "Countries Page";
}
<div class="text-center">
    <h4 class="display-4">Country List </h4>
</div>

<div class="row">
    <div class="col-xs-6 col-md-4 align-self-end">
        @Html.ActionLink("Create New","Create")
    </div>
</div>

<div class="col-md-10">

    <table class="table">
      <thead>
        <tr>
          @*<th scope="col">#</th>*@
          <th scope="col">Country Name</th>
          <th scope="col">View More</th>
          <th scope="col">Actions</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
         @foreach(var country in Model){
            <tr>
              @*<th scope="row">2</th>*@
              <td>@Html.DisplayFor(modelItem => country.Designation)</td>
              <td>@Html.ActionLink("Details","Details",new {id=country.Id})</td>
              <td>@Html.ActionLink("Edit","Edit",new {id=country.Id})</td>
              <td>@Html.ActionLink("Delete","Delete",new {id=country.Id})</td>
            </tr>
        }
      </tbody>
    </table>
</div>


@section Scripts
{
        <script src="~/js/LocationManagement.js" asp-append-version="true"></script>
        <script src="~/js/Multi-Functions.js" asp-append-version="true"></script>

}