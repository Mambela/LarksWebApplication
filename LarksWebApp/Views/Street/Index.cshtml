@using LarksWebApp.DTOs.DTO_City

@model Create_City_DTO

@{
       ViewData["Title"] = "List of Streets";
}

<h3>Create a new Street </h3>

<div class="col-md-8">

    <div class="col-xs-12 col-md-6 align-self-end">
                    @Html.ActionLink("Create New Street","Create","Street")                     
                    
    </div>


</div>


<div class="row mb-3">

    <div class="col-md-3">
        <div class="col-md-12">
            @Html.Label("Country","Country ", new { htmlAttributes = new { @class = "form-control" } })
            @Html.DropDownListFor(m=>m.CountryId,new SelectList(Model.ListofCountryDTO,"Id","Designation"),"Select Country",new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="col-md-12">
            @Html.Label("Province","Province ", new { htmlAttributes = new { @class = "form-control" } })
            @Html.DropDownList("street_ProvinceId",Enumerable.Empty<SelectListItem>(),"Select Province",new { @class = "form-control" })

        </div>
    </div>

    <div class="col-md-3">
        <div class="col-md-12">
            @Html.Label("Municipality","Municipality ", new { htmlAttributes = new { @class = "form-control" } })
            @Html.DropDownList("street_MunicipalityId",Enumerable.Empty<SelectListItem>(),"Select Municipality",new { @class = "form-control" })

        </div>
    </div>
    <div class="col-md-3">
        <div class="col-md-12">
            @Html.Label("Neighbourhood","Neighbourhood", new { htmlAttributes = new { @class = "form-control" } })
            @Html.DropDownList("street_hoodId",Enumerable.Empty<SelectListItem>(),"Select Neighbourhood",new { @class = "form-control" })

        </div>
    </div>
</div>


<div class="col-md-12 mt-5">
    <table id="streetTable" class="table table-striped table-bordered dt-responsive nowrap">
        <thead>
            <tr>
                
                <th>ID</th>
                <th>Street</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts
    {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Streets.js" asp-append-version="true"></script>

}
