 @using LarksWebApp.DTOs.DTO_Municipalities

@model Create_Municipality_DTO

@{
    ViewData["Title"] = "Create City";
    var provinceId = ViewData["provinceId"];
}

<h3>Create a new municipality</h3>


<div class="col-md-8">
@using(Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-group">
             
       @Html.LabelFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
       <div class="col-md-10">
            @Html.EditorFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
            @Html.Hidden("provinceId",new { id= "provinceId", Value = provinceId})
       </div>
    </div>

    <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
    </div>
        
}


</div>