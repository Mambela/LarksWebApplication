@model LarksWebApp.DTOs.DTO_Municipalities.ViewMunicipalityCreateDTO
@{
    ViewData["Title"] = "Municipalities";
    var isScoped = Model.ProviceId != Guid.Empty;
}

<div class="app-breadcrumb">Larks &gt; <span class="current">Municipalities</span></div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h3 class="mb-0">Municipalities</h3>
    <div class="d-flex gap-2">
        @if (isScoped)
        {
            <a class="btn btn-outline-soft" href="@Url.Action("CreateNeighbourhood","Municipalities",new{provinceId = Model.ProviceId})">+ Create New Neighbourhood</a>
        }
        <a class="btn btn-primary" href="@Url.Action("Create","Municipalities",new{provinceId = Model.ProviceId})">+ Create New Municipality</a>
    </div>
</div>

<div class="app-card">
    <div class="app-card__body">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th scope="col">Municipality</th>
                    @if (!isScoped)
                    {
                        <th scope="col">Province</th>
                    }
                    <th scope="col">Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var municipality in Model.MunicipalityDTO)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => municipality.Designation)</td>
                        @if (!isScoped)
                        {
                            <td>@municipality.ProvinceName</td>
                        }
                        <td>@Html.ActionLink("Details", "Details", new { id = municipality.Id })</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
