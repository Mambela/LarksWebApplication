 @using LarksWebApp.DTOs.DTO_Municipalities

@model Create_Municipality_DTO

@{
    ViewData["Title"] = "Edit Municipality";
}

<div class="app-breadcrumb">Larks &gt; <span class="current">Edit Municipality</span></div>
<h3 class="mb-4">Edit municipality</h3>

<div class="col-md-6">
    <div class="app-card">
        <div class="app-card__body">
            @using (Html.BeginForm("Edit", "Municipalities", new { id = Model.Id }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Province</label>
                    @Html.DropDownList("provinceId", (SelectList)ViewData["provinces"], "Select Province", new { @class = "form-control" })
                </div>

                <div class="form-group mt-2">
                    @Html.LabelFor(model => model.Designation)
                    @Html.EditorFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            }
        </div>
    </div>
</div>
