@using LarksWebApp.DTOs.DTO_Suburbs
@using Microsoft.AspNetCore.Mvc.Rendering
@model SuburbDTO
@{
    ViewData["Title"] = "Edit Suburb";
}

<div class="app-breadcrumb">Larks &gt; <span class="current">Edit Suburb</span></div>
<h3 class="mb-4">Edit Suburb</h3>

<div class="col-md-6">
    <div class="app-card">
        <div class="app-card__body">
            @using (Html.BeginForm("Edit", "Suburb", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Designation</label>
                    @Html.TextBox("Designation", Model.Designation, new { @class = "form-control" })
                </div>

                <div class="form-group mt-2">
                    <label>Municipality</label>
                    @Html.DropDownList("MunicipalityId", (SelectList)ViewData["municipalities"], new { @class = "form-control" })
                </div>

                <div class="form-group mt-2">
                    <label>City</label>
                    @Html.DropDownList("CityId", (SelectList)ViewData["cities"], "Select City", new { @class = "form-control" })
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            }
        </div>
    </div>
</div>
