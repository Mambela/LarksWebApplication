@{
    ViewData["Title"] = "Create a Suburb";
}

<div class="app-breadcrumb">Larks &gt; <span class="current">Create Suburb</span></div>
<h3 class="mb-4">Create a new Suburb</h3>

<div class="col-md-6">
    <div class="app-card">
        <div class="app-card__body">
            @using (Html.BeginForm("Create", "Suburb", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Country</label>
                    @Html.DropDownList("countryId", (SelectList)ViewData["countries"], "Select Country", new { @class = "form-control", id = "countrySelect" })
                </div>

                <div class="form-group mt-2">
                    <label>Province</label>
                    <select name="provinceId" id="provinceSelect" class="form-control" disabled>
                        <option value="">Select a country first</option>
                    </select>
                </div>

                <div class="form-group mt-2">
                    <label>City</label>
                    <select name="newCityId" id="citySelect" class="form-control" disabled>
                        <option value="">Select a province first</option>
                    </select>
                </div>

                <div class="form-group mt-2">
                    <label>District</label>
                    <select name="newDistrictId" id="districtSelect" class="form-control" disabled>
                        <option value="">Select a province first</option>
                    </select>
                </div>

                <div class="form-group mt-2">
                    <label>Municipality</label>
                    <select name="newMunicipalityId" id="municipalitySelect" class="form-control" disabled>
                        <option value="">Select a province first</option>
                    </select>
                </div>

                <div class="form-group mt-2">
                    <label>Designation</label>
                    <input type="text" name="Designation" class="form-control" required />
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Create Suburb" class="btn btn-primary" />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function fillSelect(select, items, placeholder) {
                select.innerHTML = '<option value="">' + placeholder + '</option>' +
                    items.map(function (item) {
                        return '<option value="' + item.id + '">' + item.designation + '</option>';
                    }).join('');
                select.disabled = items.length === 0;
            }

            function resetSelects(selects, placeholder) {
                selects.forEach(function (select) {
                    select.innerHTML = '<option value="">' + placeholder + '</option>';
                    select.disabled = true;
                });
            }

            var countrySelect = document.getElementById('countrySelect');
            var provinceSelect = document.getElementById('provinceSelect');
            var citySelect = document.getElementById('citySelect');
            var districtSelect = document.getElementById('districtSelect');
            var municipalitySelect = document.getElementById('municipalitySelect');

            countrySelect.addEventListener('change', function () {
                var countryId = this.value;

                resetSelects([citySelect, districtSelect, municipalitySelect], 'Select a province first');

                if (!countryId) {
                    resetSelects([provinceSelect], 'Select a country first');
                    return;
                }

                resetSelects([provinceSelect], 'Loading...');

                fetch(BASEURL + 'api/Province/CountryProvinces?CountryId=' + countryId)
                    .then(function (r) { return r.json(); })
                    .then(function (provinces) {
                        fillSelect(provinceSelect, provinces, 'Select Province');
                    }).catch(function (err) {
                        console.log('Failed to load provinces for country', err);
                    });
            });

            provinceSelect.addEventListener('change', function () {
                var provinceId = this.value;

                if (!provinceId) {
                    resetSelects([citySelect, districtSelect, municipalitySelect], 'Select a province first');
                    return;
                }

                resetSelects([citySelect, districtSelect, municipalitySelect], 'Loading...');

                Promise.all([
                    fetch(BASEURL + 'api/City/citiesinprovince?provinceId=' + provinceId).then(function (r) { return r.json(); }),
                    fetch(BASEURL + 'api/District/districtsinprovice?provinceID=' + provinceId).then(function (r) { return r.json(); }),
                    fetch(BASEURL + 'api/Municipality/MunicipalitiesInProvince?provinceId=' + provinceId).then(function (r) { return r.json(); })
                ]).then(function (results) {
                    fillSelect(citySelect, results[0], 'Select City');
                    fillSelect(districtSelect, results[1], 'Select District');
                    fillSelect(municipalitySelect, results[2], 'Select Municipality');
                }).catch(function (err) {
                    console.log('Failed to load province children', err);
                });
            });
        })();
    </script>
}
