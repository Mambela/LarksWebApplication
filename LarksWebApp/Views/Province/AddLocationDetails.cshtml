@model LarksWebApp.DTOs.DTO_Provinces.ProvinceDTO
@{
    ViewData["Title"] = "Add Location Details";
}

<div class="text-start">
    <h5 class="display-4">Add location details for @Html.DisplayFor(model => model.Designation)</h5>
</div>
<hr class="text-center col-md-10" />

<div class="row">

    <div class="col-xs-12 col-md-6 col-lg-4">
        <h5>Add a Municipality</h5>
        @using (Html.BeginForm("CreateMunicipality", "Province", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("provinceId", Model.Id)
            <div class="form-group">
                <label>Designation</label>
                <input type="text" name="designation" class="form-control" required />
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Create Municipality" class="btn btn-primary" />
            </div>
        }

        <table class="table mt-3">
            <thead>
                <tr>
                    <th scope="col">Municipalities</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var municipality in Model.Municipalities)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => municipality.Designation)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-4">
        <h5>Add a District</h5>
        @using (Html.BeginForm("CreateDistrict", "Province", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("provinceId", Model.Id)
            <div class="form-group">
                <label>Designation</label>
                <input type="text" name="designation" class="form-control" required />
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Create District" class="btn btn-primary" />
            </div>
        }

        <table class="table mt-3">
            <thead>
                <tr>
                    <th scope="col">Districts</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var district in Model.Districts)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => district.Designation)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-xs-12 col-md-6 col-lg-4">
        <h5>Add a Suburb</h5>
        @if (Model.Cities.Count == 0 || Model.Districts.Count == 0 || Model.Municipalities.Count == 0)
        {
            <p class="text-muted">A suburb needs a City, a District and a Municipality to already exist in this province. Add those first.</p>
        }
        else
        {
            @using (Html.BeginForm("CreateSuburb", "Province", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("provinceId", Model.Id)
                <div class="form-group">
                    <label>Designation</label>
                    <input type="text" name="designation" class="form-control" required />
                </div>
                <div class="form-group mt-2">
                    <label>City</label>
                    @Html.DropDownList("cityId", new SelectList(Model.Cities, "Id", "Designation"), "Select City", new { @class = "form-control" })
                </div>
                <div class="form-group mt-2">
                    <label>District</label>
                    @Html.DropDownList("districtId", new SelectList(Model.Districts, "Id", "Designation"), "Select District", new { @class = "form-control" })
                </div>
                <div class="form-group mt-2">
                    <label>Municipality</label>
                    @Html.DropDownList("municipalityId", new SelectList(Model.Municipalities, "Id", "Designation"), "Select Municipality", new { @class = "form-control" })
                </div>
                <div class="form-group mt-2">
                    <input type="submit" value="Create Suburb" class="btn btn-primary" />
                </div>
            }
        }
    </div>

</div>
