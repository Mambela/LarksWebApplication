@model IList<LarksWebApp.DTOs.DTO_Provinces.ProvinceDTO>
@{
    ViewData["Title"] = "Provinces Page";
}

<div class="text-center">
    <h4 class="display-4">Provinces List </h4>
</div>

<div class="row">
    <div class="col-xs-6 col-md-4 align-self-end">
        @Html.ActionLink("Create New","Create")
    </div>
</div>


<div class="col-md-8">

    <table class="table">
      <thead>
        <tr>
          <th scope="col">Country Name</th>
          <th scope="col">View More</th>
          <th scope="col"></th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
         @foreach(var province in Model){
            <tr>
              <td>@Html.DisplayFor(modelItem => province.Designation)</td>
              <td>@Html.ActionLink("Details","Details",new {id=province.Id})</td>
              <td>@Html.ActionLink("Edit","Edit",new {id=province.Id})</td>
              <td>@Html.ActionLink("Delete","Delete",new {id=province.Id})</td>
            </tr>
        }
      </tbody>
    </table>
</div>