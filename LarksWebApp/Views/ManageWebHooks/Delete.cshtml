@model LarksWebApp.DTOs.DTO_Addresses.HooksDTO
@{

    ViewData["Title"] = "Delete Webhook";
}

<h3>Delete Webhook </h3>

<div class="row">
    <div class="col-xs-12 col-md-12 align-self-end">

    </div>
    <div class="col-md-8 align-self-center">
        @using(Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <h5>Please note that you are trying to delete the webhook @this.Model.Designation. </h5>
                 <h6> Do you wish to proceed with this operation?</h6>
                <div class="col-md-1">
                    <div class="form-group mt-3">
                        
                            @Html.ActionLink("Cancel","index","ManageWebHooks",new{ @class = "btn-sm btn btn-primary"})
                                
                        
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mt-3">
                    <div class="col-md-offset-2 col-md-10">
                          
                            <button type="submit" value="delete" class="btn-sm btn btn-danger" >
                                Delete Webhook
                            </button>
                    </div>
                </div>
                </div>
            </div>
        }

    </div>

</div>