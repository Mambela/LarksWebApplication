@{
    ViewData["Title"] = "Register a new Webhook";
}

<h2>Create a new Webhook </h2>

<div class="row">
    <hr />
    <div class="col-md-8 align-self-center">
        @using(Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <div class="row">
                    <div class="col-md-10">
                        @Html.LabelFor(model=>model.Designation, new{htmlAttributes = new { @class ="form-control"}})
                        <div>
                            @Html.EditorFor(model =>model.Designation, new{htmlAttributes = new {@class = "form-control"}})
                        </div>
                    </div>
                    <div class="col-md-10 mt-2">
                        @Html.LabelFor(model=>model.Owner, new{htmlAttributes = new { @class ="form-control"}})
                        <div>
                            @Html.EditorFor(model =>model.Owner, new{htmlAttributes = new {@class = "form-control"}})
                        </div>
                    </div>
                    <div class="col-md-10 mt-2">
                        @Html.LabelFor(model=>model.EndPoint, new{htmlAttributes = new { @class ="form-control"}})
                        <div>
                            @Html.EditorFor(model =>model.EndPoint, new{htmlAttributes = new {@class = "form-control"}})
                        </div>
                    </div>
                    <div class="col-md-10 mt-2">
                        @Html.LabelFor(model=>model.Method, new{htmlAttributes = new { @class ="form-control"}})
                     @*   @Html.LabelFor(model=>model.Method, new{htmlAttributes = new { @class ="form-control"}})
                        <div>
                            @Html.EditorFor(model =>model.EndPoint, new{htmlAttributes = new {@class = "form-control"}})
                        </div>*@
                        <select class="form-control" name="Method">
                            <option> Get</option>
                            <option> Put</option>
                            <option> Patch</option>
                            <option> Post</option>
                        </select>

                    </div>
                  @*  <div class="mt-3">
                        @Html.Label("form-control", "Is it active")
                        @Html.CheckBoxFor(m => m.IsActive)
                      
                    </div>*@
                </div>
             </div>
            <div class="form-group mt-3">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Create Webhook" class="btn btn-primary" />
                </div>
            </div>
             
        }

    </div>
</div>


 